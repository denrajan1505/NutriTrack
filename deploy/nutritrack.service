[Unit]
Description=Nutries FastAPI Backend
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/nutritrack/backend
EnvironmentFile=/var/www/nutritrack/backend/.env
ExecStart=/var/www/nutritrack/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
